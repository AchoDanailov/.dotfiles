# git
alias gs="git status"
alias gl="git log --oneline --graph"
alias gb="git branch"
alias gcf="git cat-file -p"

# apt
# apt full update
alias afu="sudo apt update -y && sudo apt upgrade -y && sudo apt dist-upgrade -y"

# ls (i dont use it but, it can stay)
alias ls='ls $LS_OPTIONS'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
