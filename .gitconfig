[init]
	defaultBranch = main
[user]
	email = danailov.angel.99@gmail.com
	name = A. Danailov
[core]
	editor = nvim
	pager = diff-so-fancy | less --tabs=4 -RF
[interactive]
	diffFilter = diff-so-fancy --patch
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
