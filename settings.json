{
    "autoHide.autoHideLeftSideBar": false,
    "autoHide.autoHideRightSideBar": false,
    "autoHide.autoHidePanel": false,

    "chat.titleBar.openInAgentsWindow.enabled": false,
    "chat.agentsControl.enabled": "hidden",
    "chat.commandCenter.enabled": false,
    "chat.viewSessions.orientation": "stacked",
    "github.copilot.enable": {
        "sql": true
    },

    "claudeCode.preferredLocation": "panel",
    "claudeCode.hideOnboarding": true,
    "claudeCode.focusView": false,

    "diffEditor.ignoreTrimWhitespace": true,
    "diffEditor.renderGutterMenu": true,
    "diffEditor.renderSideBySide": false,

    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    "editor.codeLens": false,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.cursorSurroundingLines": 3,
    "editor.detectIndentation": false,
    "editor.fontVariations": false,
    "editor.fontSize": 15,
    "editor.fontLigatures": true,
    "editor.guides.indentation": false,
    "editor.insertSpaces": true,
    "editor.lineNumbers": "relative",
    "editor.minimap.enabled": false,
    "editor.matchBrackets": "never",
    "editor.lightbulb.enabled": "off",
    "editor.renderControlCharacters": false,
    "editor.hideCursorInOverviewRuler": true,
    "editor.gotoLocation.multipleReferences": "goto",
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleDeclarations": "goto",
    "editor.gotoLocation.multipleImplementations": "goto",
    "editor.gotoLocation.multipleTypeDefinitions": "goto",
    "editor.tabSize": 4,
    "editor.stickyScroll.enabled": false,
    "editor.unfoldOnCursorMove": false,
    "editor.wordWrap": "on",
    "editor.semanticHighlighting.enabled": true,
    "editor.showFoldingControls": "never",

    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 0,
    "files.trimTrailingWhitespace": false,

    "git.openRepositoryInParentFolders": "always",
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "liveServer.settings.donotShowInfoMsg": true,
    "security.workspace.trust.untrustedFiles": "open",
    "scm.diffDecorations": "none",

    "vim.foldfix": true,
    "vim.hlsearch": true,
    "vim.ignorecase": true,
    "vim.incsearch": true,
    "vim.leader": " ",
    "vim.scrolloff": 3,
    "vim.smartcase": true,
    "vim.useSystemClipboard": true,
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [ "<leader>", "w" ],
            "commands": [ "workbench.action.files.save" ]
        },
        {
            "before": [ "<leader>", "q" ],
            "commands": [ "workbench.action.files.save", "workbench.action.closeActiveEditor" ]
        },
        {
            "before": [ "<C-h>" ],
            "commands": [ "workbench.action.focusLeftGroup" ]
        },
        {
            "before": [ "<C-l>" ],
            "commands": [ "workbench.action.focusRightGroup" ]
        },
        {
            "before": [ "<C-j>" ],
            "commands": [ "workbench.action.focusBelowGroup" ]
        },
        {
            "before": [ "<C-k>" ],
            "commands": [ "workbench.action.focusAboveGroup" ]
        },
        {
            "before": [ "<leader>", "e" ],
            "commands": ["workbench.view.explorer"]
        },
        {
            "before": [
                "<leader>",
                "<space>"
            ],
            "commands": [
                "workbench.action.showCommands"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "f"
            ],
            "commands": [
                "workbench.action.quickOpen"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "s"
            ],
            "commands": [
                "workbench.action.gotoSymbol"
            ]
        },
        {
            "before": [
                "g",
                "i"
            ],
            "commands": [
                "editor.action.goToImplementation"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "g"
            ],
            "commands": [
                "workbench.action.findInFiles"
            ]
        },
        {
            "before": [
                "<leader>",
                "b"
            ],
            "commands": [
                "editor.debug.action.toggleBreakpoint"
            ]
        },
        {
            "before": [
                "<leader>",
                "c"
            ],
            "commands": [
                "editor.action.commentLine"
            ]
        },
        {
            "before": [
                "<C-w>",
                "v"
            ],
            "commands": [
                "workbench.action.splitEditorRight"
            ]
        },
        {
            "before": [
                "<C-w>",
                "s"
            ],
            "commands": [
                "workbench.action.splitEditorDown"
            ]
        },
        {
            "before": [
                "<leader>",
                "n"
            ],
            "commands": [
                "workbench.action.nextEditor"
            ]
        },
        {
            "before": [
                "<leader>",
                "p"
            ],
            "commands": [
                "workbench.action.previousEditor"
            ]
        },
        {
            "before": [
                "<leader>",
                "d"
            ],
            "commands": [
                "workbench.action.closeActiveEditor"
            ]
        },
        {
            "before": [
                "K"
            ],
            "commands": [
                "editor.action.showHover"
            ]
        },
        {
            "before": [
                "<leader>",
                "o"
            ],
            "commands": [
                "liveServer.goOnline"
            ]
        },
        {
            "before": [
                "<leader>",
                "i"
            ],
            "commands": [
                "editor.action.showHover"
            ]
        }
    ],

    "python.analysis.typeCheckingMode": "strict",

    "excalidraw.theme": "dark",

    "workbench.browser.showInTitleBar": false,
    "workbench.layoutControl.enabled": false,
    "workbench.navigationControl.enabled": false,
    "workbench.startupEditor": "none",
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "workbench.tree.indent": 20,
    "workbench.tree.renderIndentGuides": "always",
    "workbench.activityBar.location": "top",
    "workbench.sideBar.location": "right",
    "workbench.colorTheme": "Rosé Pine (tmux 256)",
    "extensions.supportAgentsWindow": {
        "ltmoerdani.opencode-copilot-chat": true
    }
}
